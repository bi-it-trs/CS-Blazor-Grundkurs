@using LernaufgabenTracker.Models

<section>
    <h2>@Aufgabe.Titel</h2>

    <ul>
        <li>@(Aufgabe.Beschreibung ?? "Keine Beschreibung")</li>
        <li>Status: @Aufgabe.Status</li>
    </ul>
    @if (Aufgabe.Status != AufgabenStatus.Erledigt)
    {
        <button type="button"
            @onclick="()=> OnErledigt.InvokeAsync(Aufgabe)">
                Erledigt
            </button>
    }
</section>


@code {
    [Parameter]
    public TaskItem Aufgabe { get; set; } = default!;

    [Parameter]
    public EventCallback<TaskItem> OnErledigt { get; set; }
}