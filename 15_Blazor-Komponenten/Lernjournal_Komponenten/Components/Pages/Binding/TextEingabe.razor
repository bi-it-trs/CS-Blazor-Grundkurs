<fieldset>
    <legend>Kind: TextEingabe</legend>
    <label>Text bearbeiten: <input value="@Text" @oninput="TextMeldenAsync" /></label>
</fieldset>

@code {
    [Parameter]
    public string Text { get; set; } = "";

    [Parameter]
    public EventCallback<string> TextChanged { get; set; }

    private async Task TextMeldenAsync(ChangeEventArgs ereignis)
    {
        string neuerText = ereignis.Value?.ToString() ?? "";
        await TextChanged.InvokeAsync(neuerText);
    }
}
