<button type="button" class="farbknopf schrittknopf" @onclick="() => OnSchritt.InvokeAsync(Schritt)" >
    @Beschriftung <span aria-hidden="true">(@Schritt)</span>
</button>

@code {
    [Parameter]
    public string Beschriftung { get; set; } = string.Empty;

    [Parameter]
    public int Schritt { get; set; }

    [Parameter]
    public EventCallback<int> OnSchritt { get; set; }
}
